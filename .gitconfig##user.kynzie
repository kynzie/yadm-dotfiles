[user]
	name = Alizée Penel
	email = alizee.penel@gmail.com
	signingKey = D9D1EF112A725BA3908E3AF35B1F2940A6A760F6

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	rebase = true

[branch]
	sort = -committerdate

[diff]
	algorithm = histogram
	colorMoved = default

[format]
	signOff = true

[commit]
	verbose = true
	gpgSign = true

[tag]
	gpgSign = true

[rebase]
	autoStash = true
	updateRefs = true

[push]
	autoSetupRemote = true
	followTags = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[http]
	cookiefile = ~/.gitcookies

[color "branch"]
	current = green bold
	local = dim
	remote = green dim
	upstream = cyan
	plain = yellow

[color "diff"]
	context = dim
	meta = "#ff8000"
	frag = "#3399ff"
	func = "#00ffff"
	old = red bold
	new = green bold
	commit = yellow
	whitespace = red white bold reverse

[color "decorate"]
	branch = green bold
	remoteBranch = green dim
	tag = "#ff8000" bold reverse
	stash = red
	HEAD = cyan

[color "grep"]
	context = dim
	filename = magenta
	function = "#00ffff"
	linenumber = green
	matchSelected = red bold
	selected = white bold

[color "interactive"]
	prompt = cyan
	header = dim
	help = yellow
	error = red bold

[color "status"]
	header = dim
	added = green bold
	changed = red bold
	untracked = yellow bold
	branch = "#ff8000" bold reverse
	nobranch = red bold reverse
	unmerged = yellow bold reverse

[alias]
	ck = checkout
	br = branch
	co = commit -s
	coa = commit -s --amend
	chp = cherry-pick
	st = status
	rb = rebase
	rzt = reset
	rZt = reset --hard
	a = add
	ap = add -p
	l = log --decorate
	g = grep
	df = diff
	dfc = diff --cached
	visual = !gitk --all
	last = log -1 HEAD
	rbi = rebase --autosquash -i
	rbc = rebase --continue
	rba = rebase --abort
	save = !git add -A && git commit -m 'SAVEPOINT'
	wip = !git add -u && git commit -m "WIP"
	test = !git push -n
	sw = switch
	swc = switch -c
	rst = restore
	rstS = restore -S

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
