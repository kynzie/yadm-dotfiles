# Refresh the agent's stubs after switching to another smartcard holding the
# same keys (otherwise gpg keeps asking for the previous card).
reshadow() {
	gpg-connect-agent "scd serialno" "learn --force" /bye
}

# Terminal used by pinentry-curses/tty when gpg runs from this shell
GPG_TTY=$(tty)
export GPG_TTY

# Local session only: over SSH, keep the forwarded agent and the remote tty
if [ -z "${SSH_CONNECTION:-}" ]; then
	# SSH requests reach gpg-agent without a tty or display of their own:
	# point the agent's pinentry at this session (tty, DISPLAY, WAYLAND...).
	gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1

	# Let ssh use gpg-agent (unless gpg-agent itself started this shell)
	unset SSH_AGENT_PID
	if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
		SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
		export SSH_AUTH_SOCK
	fi
fi
